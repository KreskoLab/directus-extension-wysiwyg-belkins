{
	"name": "directus-extension-wysiwyg-belkins",
	"version": "1.0.1",
	"description": "Standalone copy of the Directus WYSIWYG (rich text HTML) interface, powered by TinyMCE",
	"icon": "format_quote",
	"license": "BUSL-1.1",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-interface",
		"wysiwyg",
		"tinymce",
		"rich-text"
	],
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/KreskoLab/directus-extension-wysiwyg-belkins.git"
	},
	"homepage": "https://github.com/KreskoLab/directus-extension-wysiwyg-belkins#readme",
	"bugs": {
		"url": "https://github.com/KreskoLab/directus-extension-wysiwyg-belkins/issues"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"directus:extension": {
		"type": "interface",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^11.0.0 || ^12.0.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"typecheck": "vue-tsc --noEmit",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "17.1.4",
		"@directus/types": "^15.0.3",
		"@rollup/plugin-url": "^8.0.2",
		"@tinymce/tinymce-vue": "6.3.0",
		"@types/lodash": "^4.17.20",
		"lodash": "^4.17.21",
		"mime": "^4.1.0",
		"tinymce": "6.8.6",
		"typescript": "^5.9.2",
		"vue": "^3.5.24",
		"vue-i18n": "^11.4.2",
		"vue-tsc": "^2.2.12"
	}
}
